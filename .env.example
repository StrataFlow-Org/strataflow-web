# Horizon REST API Endpoint
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# StrataFlow Smart Contract Address (Soroban C... StrKey format)
NEXT_PUBLIC_STRATAFLOW_CONTRACT_ID=CDLZ73VU7Y4Z45ETK26QU62NDXQJ2277NY2Y57C2ZFU7SS7M6HWT7G4H

# Backend Indexer & Auth API URL
NEXT_PUBLIC_API_URL=http://localhost:3001
